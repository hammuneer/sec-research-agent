# Secrets - never commit
.env
.env.*
!.env.example
*credentials*.json
service_account*.json
*.json.key
*.pem

# Local data (downloaded filings, reports, caches, prompt overrides)
data/*
!data/.gitkeep
.report_cache/
*.pkl
*.npz

# Python
__pycache__/
*.py[cod]
*.so
.venv/
venv/
env/
build/
dist/
*.egg-info/
.eggs/

# Tooling
.ruff_cache/
.mypy_cache/
.pytest_cache/
.coverage
coverage.xml
htmlcov/

# Streamlit secrets (keep .streamlit/config.toml tracked)
.streamlit/secrets.toml

# Editors / OS
.vscode/
.idea/
*.swp
.DS_Store
Thumbs.db

# Logs
*.log
