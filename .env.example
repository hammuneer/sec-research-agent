# Copy to `.env` and fill in. Never commit `.env`.

# OpenAI - embeddings, topic extraction and report writing
OPENAI_API_KEY=sk-...

# https://sec-api.io - 10-K / 10-Q / DEF 14A search and PDF rendering
SEC_API_KEY=

# https://earningscall.biz - earnings call transcripts
EARNINGSCALL_API_KEY=

# Where company folders are stored (default: ./data)
# DATA_DIR=./data

# Optional: alternative settings file (default: ./config/settings.yaml)
# CONFIG_FILE=./config/settings.yaml

# LOG_LEVEL=INFO
